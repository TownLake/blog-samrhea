---
import TimelineItem from '../components/TimelineItem.astro';
import Layout from '../layouts/Layout.astro';
import career from '../data/career.json';
import education from '../data/education.json';
import patents from '../data/patents.json';

const linkClass = 'text-accent-blue underline underline-offset-2 hover:text-white transition-colors duration-150';
const sectionHeading = 'text-xs font-mono text-midnight-500 uppercase tracking-widest';

const schools = [
    { heading: 'Teaching', entries: education.filter((s) => s.teaching) },
    { heading: 'Studying', entries: education.filter((s) => !s.teaching) },
];
---

<Layout title="About — Sam Rhea">
    <div class="space-y-16">

        <section class="space-y-4">
            <p class="text-base text-midnight-200 leading-relaxed">
                Hi there. My name is Sam. I am a Texan living in Lisbon. I work at Cloudflare.
            </p>
            <p class="text-base text-midnight-200 leading-relaxed">
                I'm probably busy right now building an application for a hobby project that doesn't need one. Or walking a dog we named after the second-worst highway in Austin.
            </p>
        </section>

        <section>
            <h2 class:list={[sectionHeading, 'mb-8']}>At Work</h2>
            <div class="relative">
                <div class="absolute left-[11px] top-0 bottom-0 w-px bg-midnight-800"></div>
                <div class="space-y-12">
                    {career.map((job) => (
                        <TimelineItem name={job.name} period={job.period} color={job.color} logo={job.logo} spacious>
                            <div class="space-y-10 relative z-10">
                                {job.roles.map((role) => (
                                    <div>
                                        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline mb-3">
                                            <h4 class="text-sm font-medium text-midnight-200">{role.title}</h4>
                                            {job.roles.length > 1 && (
                                                <span class="text-xs text-midnight-500 font-mono tabular-nums">{role.period}</span>
                                            )}
                                        </div>
                                        <div class="text-sm text-midnight-400 leading-relaxed">
                                            {role.achievements.map((achievement, index) => {
                                                // An achievement is plain text or a list of text and link parts.
                                                const content = Array.isArray(achievement) ? (
                                                    <span>
                                                        {achievement.map((part) =>
                                                            typeof part === 'string' ? part : (
                                                                <a href={part.link} target="_blank" rel="noopener noreferrer" class={linkClass}>{part.text}</a>
                                                            ),
                                                        )}
                                                    </span>
                                                ) : achievement;

                                                // The first achievement is a summary; the rest are a dashed list.
                                                return index === 0 ? (
                                                    <div class="mb-3">{content}</div>
                                                ) : (
                                                    <div class="flex gap-3 items-baseline mb-2">
                                                        <span class="shrink-0 text-midnight-500 select-none">–</span>
                                                        <span>{content}</span>
                                                    </div>
                                                );
                                            })}
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </TimelineItem>
                    ))}
                </div>
            </div>
        </section>

        <section>
            <h2 class:list={[sectionHeading, 'mb-6']}>Patents</h2>
            {patents.map((patent) => (
                <div class="-mx-4 px-4 py-3 rounded-lg hover:bg-midnight-900/40 transition-colors duration-150">
                    <a href={patent.link} target="_blank" rel="noopener noreferrer" class="group">
                        <div class="flex items-center gap-2 mb-1.5">
                            <h3 class="text-sm text-midnight-200 font-medium group-hover:text-white transition-colors duration-150">{patent.title}</h3>
                            <svg class="w-3.5 h-3.5 text-midnight-500 group-hover:text-midnight-300 shrink-0 transition-colors duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                        </div>
                        <div class="flex items-center gap-2 text-xs font-mono text-midnight-500 mb-2">
                            <span>{patent.patentNumber}</span>
                            <span aria-hidden="true">·</span>
                            <span>{patent.issueDate}</span>
                        </div>
                    </a>
                    <p class="text-sm text-midnight-400 leading-relaxed mb-2">{patent.summary}</p>
                    <details class="group/details">
                        <summary class="text-xs text-midnight-500 hover:text-midnight-300 cursor-pointer transition-colors duration-150 select-none">
                            <span class="group-open/details:hidden">Show full abstract</span>
                            <span class="hidden group-open/details:inline">Hide abstract</span>
                        </summary>
                        <p class="text-sm text-midnight-500 leading-relaxed mt-2">{patent.description}</p>
                    </details>
                </div>
            ))}
        </section>

        {schools.map(({ heading, entries }) => (
            <section>
                <h2 class:list={[sectionHeading, 'mb-8']}>{heading}</h2>
                <div class="relative">
                    <div class="absolute left-[11px] top-0 bottom-0 w-px bg-midnight-800"></div>
                    <div class="space-y-10">
                        {entries.map((school) => (
                            <TimelineItem name={school.name} period={school.period} color={school.color} logo={school.logo}>
                                {school.roles.map((role) => (
                                    <div class="mb-4">
                                        <p class="text-sm text-midnight-200">{role.title}</p>
                                        {role.achievements[0] && (
                                            <p class="text-sm text-midnight-500 mt-0.5">{role.achievements[0]}</p>
                                        )}
                                    </div>
                                ))}

                                {school.sections.length > 0 && (
                                    <div class="space-y-5">
                                        {school.sections.map((section) => (
                                            <div>
                                                <h4 class="text-xs font-medium text-midnight-400 uppercase tracking-wider mb-2 border-l-2 border-midnight-700 pl-3">{section.title}</h4>
                                                <ul class="space-y-1.5 pl-3">
                                                    {section.items.map((item) => (
                                                        <li class="text-sm text-midnight-400">
                                                            {typeof item === 'string' ? (
                                                                <span>{item}</span>
                                                            ) : (
                                                                <a href={item.link} target="_blank" rel="noopener noreferrer" class={linkClass}>{item.text}</a>
                                                            )}
                                                        </li>
                                                    ))}
                                                </ul>
                                            </div>
                                        ))}
                                    </div>
                                )}
                            </TimelineItem>
                        ))}
                    </div>
                </div>
            </section>
        ))}
    </div>
</Layout>
