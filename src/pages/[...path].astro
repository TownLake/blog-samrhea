---
import type { GetStaticPaths } from 'astro';
import FilterBar from '../components/FilterBar.astro';
import Pagination from '../components/Pagination.astro';
import PostCard from '../components/PostCard.astro';
import Layout from '../layouts/Layout.astro';
import { FILTERS, PAGE_SIZE, TOPICS_WITH_TABS, byYear, getEntries, topicSlug, type Entry } from '../lib/content';

// Every listing page: the homepage tabs (/, /reading/, ...) and a page per topic (/tag/habits/, ...),
// each split into pages of PAGE_SIZE (/reading/2/, ...).
export const getStaticPaths = (async () => {
    const entries = await getEntries();

    const listings: Listing[] = FILTERS.map((filter) => ({
        base: filter.slug ? `/${filter.slug}/` : '/',
        name: filter.slug ? filter.label : 'Writing',
        filter: filter.slug,
        entries: entries.filter(filter.match),
    }));

    const topics = [...new Set(entries.flatMap((e) => e.topics))].filter((t) => !(t in TOPICS_WITH_TABS));
    for (const topic of topics) {
        listings.push({
            base: `/tag/${topicSlug(topic)}/`,
            name: `Tagged “${topic}”`,
            topic,
            entries: entries.filter((e) => e.topics.includes(topic)),
        });
    }

    return listings.flatMap(({ entries, ...listing }) => {
        const totalPages = Math.max(1, Math.ceil(entries.length / PAGE_SIZE));
        return Array.from({ length: totalPages }, (_, i) => {
            const page = i + 1;
            const path = `${listing.base}${page > 1 ? `${page}/` : ''}`.replace(/^\/|\/$/g, '');
            return {
                params: { path: path || undefined },
                props: { ...listing, page, totalPages, total: entries.length, entries: entries.slice(i * PAGE_SIZE, page * PAGE_SIZE) },
            };
        });
    });
}) satisfies GetStaticPaths;

interface Listing {
    /** URL of the first page. */
    base: string;
    name: string;
    /** The homepage tab this listing belongs to, if any. */
    filter?: string;
    topic?: string;
    entries: Entry[];
}

interface Props extends Listing {
    page: number;
    totalPages: number;
    /** Entries in the whole listing, across pages. */
    total: number;
}

const { base, name, filter, topic, page, totalPages, total, entries } = Astro.props;
const legacyFilters = Object.fromEntries(FILTERS.map((f) => [f.legacy, f.slug]));
---

<Layout title={`${name}${page > 1 ? `, page ${page}` : ''} — Sam Rhea`}>
    {base === '/' && page === 1 && (
        <script is:inline define:vars={{ legacyFilters }}>
            // The homepage used to filter client-side with ?filter=…&page=…; send those links to the static pages.
            const params = new URLSearchParams(location.search);
            const slug = legacyFilters[params.get('filter')];
            if (slug !== undefined) {
                const page = Number(params.get('page'));
                location.replace(`/${slug ? `${slug}/` : ''}${page > 1 ? `${page}/` : ''}`);
            }
        </script>
    )}

    <h1 class="sr-only">{name}{page > 1 ? `, page ${page}` : ''}</h1>

    <FilterBar active={filter} />

    {topic && (
        <div class="mt-5 flex items-center gap-3">
            <a
                href="/"
                aria-label={`Clear the “${topic}” filter`}
                class="inline-flex items-center gap-1.5 rounded-full bg-raised py-1 pl-3 pr-2 text-[13px] font-medium text-fg shadow-[inset_0_0_0_1px_var(--color-line)] transition-colors duration-150 hover:bg-elevated"
            >
                {topic}
                <svg class="size-3.5 text-fg-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" d="M7 7l10 10M17 7L7 17" />
                </svg>
            </a>
            <span class="eyebrow tabular-nums">{total} {total === 1 ? 'post' : 'posts'}</span>
        </div>
    )}

    <div class="mt-8 space-y-10">
        {byYear(entries).map(([year, items]) => (
            <section aria-labelledby={`year-${year}`}>
                <h2 id={`year-${year}`} class="flex items-center gap-4 mb-2 font-display text-[1.375rem] text-fg-3 tabular-nums">
                    {year}
                    <span class="h-px grow bg-line" aria-hidden="true"></span>
                </h2>
                <div class="-mx-3">
                    {items.map((entry) => <PostCard entry={entry} />)}
                </div>
            </section>
        ))}
    </div>

    <Pagination page={page} totalPages={totalPages} base={base} />
</Layout>
