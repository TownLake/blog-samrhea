---
import { Font } from 'astro:assets';
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	/** Absolute URL of an image for link previews. */
	image?: string;
	/** Set on post pages so link previews show them as articles. */
	published?: Date;
}

const {
	title,
	description = 'Sam Rhea - Writing about technology, Texas, and Portugal',
	image,
	published,
} = Astro.props;
const notFound = Astro.url.pathname.startsWith('/404');
const canonical = notFound ? undefined : new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="bg-canvas text-fg antialiased">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark light" />
		<meta name="theme-color" content="#0a0b0e" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="alternate" type="application/rss+xml" title="Sam Rhea" href="/rss.xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<Font cssVariable="--font-inter" preload={[{ subset: 'latin', style: 'normal' }]} />
		<Font cssVariable="--font-newsreader" preload={[{ subset: 'latin', style: 'normal' }]} />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:site_name" content="Sam Rhea" />
		<meta property="og:type" content={published ? 'article' : 'website'} />
		{published && <meta property="article:published_time" content={published.toISOString()} />}
		{image && <meta property="og:image" content={image} />}
		<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
	</head>
	<body class="min-h-screen flex flex-col items-center selection:bg-accent/25">
		<div class="scroll-edge" aria-hidden="true"></div>
		<Nav />
		<main class="w-full max-w-2xl px-6 pt-12 sm:pt-14 pb-24 grow">
			<slot />
		</main>
	</body>
</html>
