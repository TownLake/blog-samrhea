---
import { FILTERS } from '../lib/content';

interface Props {
    /** Slug of the active tab; omitted on tag pages, where no tab is active. */
    active?: string;
}

const { active } = Astro.props;
---

<div class="flex flex-wrap gap-1">
    {FILTERS.map((f) => (
        <a
            href={f.slug ? `/${f.slug}/` : '/'}
            data-astro-prefetch
            aria-current={active === f.slug ? 'page' : undefined}
            class:list={[
                'px-3 py-1.5 text-xs font-medium rounded-md transition-all duration-150',
                active === f.slug
                    ? 'bg-white text-midnight-950'
                    : 'text-midnight-500 hover:text-midnight-200 hover:bg-midnight-900/50',
            ]}
        >
            {f.label}
        </a>
    ))}
</div>
