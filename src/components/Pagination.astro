---
interface Props {
    page: number;
    totalPages: number;
    /** URL of page 1, e.g. `/` or `/reading/`. Later pages append the page number. */
    base: string;
}

const { page, totalPages, base } = Astro.props;
const href = (n: number) => (n === 1 ? base : `${base}${n}/`);
---

{totalPages > 1 && (
    <nav aria-label="Pagination" class="mt-16 pt-6 border-t border-midnight-800/40 flex items-center justify-between">
        <div>
            {page > 1 && (
                <a
                    href={href(page - 1)}
                    rel="prev"
                    data-astro-prefetch
                    class="text-sm text-midnight-500 hover:text-white transition-colors duration-150 flex items-center gap-1"
                >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                    </svg>
                    Newer
                </a>
            )}
        </div>

        <span class="text-xs font-mono text-midnight-500 tabular-nums">
            {page}/{totalPages}
        </span>

        <div>
            {page < totalPages && (
                <a
                    href={href(page + 1)}
                    rel="next"
                    data-astro-prefetch
                    class="text-sm text-midnight-500 hover:text-white transition-colors duration-150 flex items-center gap-1"
                >
                    Older
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                    </svg>
                </a>
            )}
        </div>
    </nav>
)}
