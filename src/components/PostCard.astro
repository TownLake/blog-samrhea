---
import { formatDate, type Entry } from '../lib/content';

interface Props {
    entry: Entry;
}

const { title, date, url, description, external } = Astro.props.entry;
---

<article class="group py-4 -mx-3 px-3 rounded-lg hover:bg-midnight-900/30 transition-colors duration-150">
    <a
        href={url}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
        data-astro-prefetch={external ? undefined : true}
        class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6"
    >
        <time datetime={date.toISOString().slice(0, 10)} class="shrink-0 w-20 text-xs font-mono text-midnight-500 tabular-nums">
            {formatDate(date, { year: 'numeric', month: 'short' })}
        </time>
        <div class="grow min-w-0">
            <h2 class="text-[15px] font-medium text-midnight-200 group-hover:text-white transition-colors duration-150">
                {title}
                {external && (
                    <svg class="inline-block w-3 h-3 ml-1 -mt-0.5 text-midnight-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    <span class="sr-only">(on the Cloudflare blog)</span>
                )}
            </h2>
            {description && (
                <p class="mt-1 text-sm text-midnight-400 line-clamp-2">
                    {description}
                </p>
            )}
        </div>
    </a>
</article>
