---
import { formatDate, tileTransition, type Entry } from '../lib/content';
import EmojiTile from './EmojiTile.astro';

interface Props {
    entry: Entry;
}

const { name, emoji, tint, date, url, description, external } = Astro.props.entry;
---

<article>
    <a
        href={url}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
        data-astro-prefetch={external ? undefined : true}
        class="group flex items-start gap-4 rounded-2xl px-3 py-3 transition-colors duration-150 hover:bg-raised"
    >
        <EmojiTile emoji={emoji} tint={tint} transition={external ? undefined : tileTransition(url)} />
        <div class="grow min-w-0 pt-0.5">
            <h3 class="text-base/snug font-medium tracking-[-0.01em] text-fg text-pretty">
                {name}
                {external && (
                    <svg class="inline-block size-3.5 ml-0.5 -mt-0.5 text-fg-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M8 7h9v9" />
                    </svg>
                    <span class="sr-only">(on the Cloudflare blog)</span>
                )}
            </h3>
            {description && <p class="mt-1 text-sm/normal text-fg-2 line-clamp-2">{description}</p>}
        </div>
        <time datetime={date.toISOString().slice(0, 10)} class="shrink-0 pt-1 text-[13px] text-fg-3 tabular-nums">
            {formatDate(date, { month: 'short', day: 'numeric' })}
        </time>
    </a>
</article>
