---
const { pathname } = Astro.url;
const onAbout = pathname.startsWith('/about');
const onListing = !onAbout && !pathname.startsWith('/posts/') && !pathname.startsWith('/404');

const links = [
    { href: '/', label: 'Writing', active: onListing },
    { href: '/about/', label: 'About', active: onAbout },
];
---

<nav class="w-full max-w-2xl px-6 py-6 flex justify-between items-center">
    <a href="/" class="text-sm font-medium tracking-tight text-midnight-100 hover:text-white transition-colors duration-150">
        Sam Rhea
    </a>
    <div class="flex gap-8 text-sm">
        {links.map(({ href, label, active }) => (
            <a
                href={href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                    'transition-colors duration-150',
                    active ? 'text-white' : 'text-midnight-500 hover:text-midnight-200',
                ]}
            >
                {label}
            </a>
        ))}
    </div>
</nav>
