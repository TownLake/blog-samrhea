---

<footer class="w-full max-w-2xl px-6 py-12 mt-auto border-t border-midnight-800/40">
    <div class="flex justify-between items-center">
        <span class="text-xs text-midnight-500 font-mono">© {new Date().getFullYear()}</span>
        <div class="flex gap-4">
            {socialLinks.map(({ href, label, icon }) => {
                const external = href.startsWith('http');
                return (
                    <a
                        href={href}
                        target={external ? '_blank' : undefined}
                        rel={external ? 'noopener noreferrer' : undefined}
                        class="text-midnight-500 hover:text-midnight-200 transition-colors duration-150"
                        aria-label={label}
                    >
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path d={icon} />
                        </svg>
                    </a>
                );
            })}
        </div>
    </div>
</footer>
